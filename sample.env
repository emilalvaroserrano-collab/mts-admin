# Copy to .env and fill in the values you use.
# Environment values win over the same settings saved in the admin UI.

# --- Database (Neon on Vercel) ---
# Leave unset in local preview. The app then uses a built-in database.
# On Vercel, paste the Neon integration variables. Any one of these is enough
# for the running app. Migrations prefer the unpooled URL when it is set.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_PRISMA_URL=
# Do not commit the real password. Set the values in the Vercel project, not in git.

# --- Auth ---
# Set to false to skip sign-in and use the local dev user.
# VITE_AUTH_ENABLED=true
# BETTER_AUTH_SECRET=replace-with-a-long-random-string
# BETTER_AUTH_URL=http://127.0.0.1:8080
# Federated Google and Microsoft sign-in. The deployer injects these when published.
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# --- Zendesk ---
# All three are required before the API is used. The subdomain is the part before .zendesk.com.
# ZENDESK_SUBDOMAIN=your-company
# ZENDESK_EMAIL=agent@your-company.com
# ZENDESK_API_TOKEN=

# --- Stripe (card payments) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Alternative Payments ---
# sandbox uses https://public-api.demo.alternativepayments.io
# live uses https://public-api.alternativepayments.io
# Unset ALTERNATIVE_ENV stays on sandbox.
# ALTERNATIVE_ENV=sandbox
# ALTERNATIVE_CLIENT_ID=
# ALTERNATIVE_CLIENT_SECRET=
# Optional override of the API host.
# ALTERNATIVE_API_BASE=
