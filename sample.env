# Copy to .env and fill in the values you use.
# Environment values win over the same settings saved in the admin UI.

# --- Database (Neon on Vercel) ---
# Leave unset in local preview. The app then uses a built-in database.
# On Vercel, paste the Neon integration variables. Any one of these is enough
# for the running app. Migrations prefer the unpooled URL when it is set.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_PRISMA_URL=
# Do not commit the real password. Set the values in the Vercel project, not in git.

# --- Auth ---
# Set to false to skip sign-in and use the local dev user.
# VITE_AUTH_ENABLED=true
# The first signed-in person is a customer. Set this only to create the first owner
# when the staff table is empty. It does nothing once an owner exists.
# BOOTSTRAP_OWNER_EMAIL=
# BETTER_AUTH_SECRET=replace-with-a-long-random-string
# BETTER_AUTH_URL=https://mts.192-888-702-801.site
# Google and Microsoft return to https://mts.192-888-702-801.site/login
# Auth0 (Vercel Auth0 integration). Set these on the Vercel project, not in git.
# The Auth0 application must allow this callback:
#   https://your-domain.example/api/auth/oauth2/callback/auth0
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_SECRET=
# Management API credentials are not used for sign-in.
# AUTH0_MANAGEMENT_API_CLIENT_ID=
# AUTH0_MANAGEMENT_API_CLIENT_SECRET=
# Federated Google and Microsoft sign-in. The deployer injects these when published.
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# --- Zendesk ---
# Support API. The shop OAuth client uses the client-credentials grant.
# Token URL is https://shop.zendesk.com/oauth/tokens
# ZENDESK_SUBDOMAIN=shop
# ZENDESK_OAUTH_CLIENT_ID=
# ZENDESK_OAUTH_CLIENT_SECRET=
# ZENDESK_OAUTH_SCOPES=read write
# Optional API-token fallback. Not required when the OAuth client is set.
# ZENDESK_EMAIL=
# ZENDESK_API_TOKEN=
# Conversations API (messaging). These are not the Support API token.
# ZENDESK_CONVERSATIONS_APP_ID=
# ZENDESK_CONVERSATIONS_KEY_ID=
# ZENDESK_CONVERSATIONS_SECRET=
# Signed webhook. Point Zendesk at https://your-domain/api/zendesk/webhook
# ZENDESK_WEBHOOK_ID=
# ZENDESK_WEBHOOK_SECRET=

# --- UPS tracking ---
# Used when a warehouse scan reads a 1Z air waybill.
# Leave UPS_ENV unset for the live UPS API. Set sandbox only for CIE test labels.
# UPS_CLIENT_ID=
# UPS_CLIENT_SECRET=
# UPS_ENV=production

# Hourly job drain. Vercel sends this as Authorization: Bearer.
# CRON_SECRET=
# Customer email. Both are required before a message leaves the portal.
# RESEND_API_KEY=
# EMAIL_FROM=Manage Tech Service <noreply@managetechservice.com>
# Signs Alternative Payments webhooks at POST /api/payments/alternative
# ALTERNATIVE_WEBHOOK_SECRET=
# --- Stripe (card payments) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Alternative Payments sandbox ---
# Generated sandbox pair for the shop card capture. Replace with the partner keys
# from go.alternativepayments.io when the live gateway is ready.
ALTERNATIVE_ENV=sandbox
